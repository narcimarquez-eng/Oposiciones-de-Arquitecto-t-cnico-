Content-Location: https://ws040.juntadeandalucia.es/sedeboja/combo/?browserId=other&minifierType=&languageId=es_ES&b=6205&t=1452609014000&/sedeboja/html/js/aui/cssbutton/cssbutton-min.css&/sedeboja/html/js/aui/widget-modality/assets/skins/sam/widget-modality.css&/sedeboja/html/js/aui/resize-base/assets/skins/sam/resize-base.css

@charset "utf-8";

.yui3-button { display: inline-block; zoom: 1; font-size: 100%; padding: 0.4em 1em 0.45em; line-height: normal; white-space: nowrap; vertical-align: baseline; text-align: center; cursor: pointer; -webkit-user-drag: none; user-select: none; color: rgba(0, 0, 0, 0.8); border: rgba(0, 0, 0, 0); background-color: rgb(230, 230, 230); background-image: linear-gradient(rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.15) 40%, transparent); text-decoration: none; border-radius: 4px; box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 0px 1px inset, rgba(255, 255, 255, 0.3) 0px 2px 0px inset, rgba(0, 0, 0, 0.15) 0px 1px 2px; transition: box-shadow 0.1s linear; }

a.yui3-button { color: rgb(68, 68, 68); text-decoration: none; }

.yui3-button-hover, .yui3-button:hover { background-image: linear-gradient(transparent, rgba(0, 0, 0, 0.05) 40%, rgba(0, 0, 0, 0.15)); }

.yui3-button-active, .yui3-button:active { border: rgba(0, 0, 0, 0); background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.15)); box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 0px 1px inset, rgba(0, 0, 0, 0.3) 0px 2px 4px inset; }

.yui3-button[disabled], .yui3-button-disabled, .yui3-button-disabled:hover, .yui3-button-disabled:active { cursor: default; background-image: none; opacity: 0.55; box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 0px 1px inset; }

.yui3-button-hidden { display: none; }

.yui3-skin-sam .yui3-button-primary, .yui3-skin-sam .yui3-button-selected { background-color: rgb(52, 95, 203); color: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 0px 1px inset, rgba(255, 255, 255, 0.17) 0px 2px 0px inset, rgba(0, 0, 0, 0.15) 0px 1px 2px; }

.yui3-skin-night .yui3-button { border: 0px; background-color: rgb(52, 53, 54); color: rgb(220, 220, 220); box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 0px 1px inset, rgba(255, 255, 255, 0.15) 0px 2px 0px inset, rgba(0, 0, 0, 0.15) 0px 1px 2px; }

.yui3-skin-night .yui3-button-primary, .yui3-skin-night .yui3-button-selected { background-color: rgb(116, 117, 118); text-shadow: rgba(0, 0, 0, 0.7) 0px 1px 2px; }

#yui3-css-stamp.cssbutton { display: none; }

.yui3-skin-sam .yui3-widget-mask { background-color: black; zoom: 1; opacity: 0.4; }

#yui3-css-stamp.skin-sam-widget-modality { display: none; }

.yui3-resize, .yui3-resize-wrapper { z-index: 0; zoom: 1; }

.yui3-resize-handle { position: absolute; display: block; z-index: 100; zoom: 1; }

.yui3-resize-proxy { border: 1px dashed rgb(0, 0, 0); position: absolute; z-index: 10000; }

.yui3-resize-hidden-handles .yui3-resize-handle { opacity: 0; }

.yui3-resize-handle-t, .yui3-resize-handle-b { width: 100%; left: 0px; height: 6px; }

.yui3-resize-handle-l, .yui3-resize-handle-r { height: 100%; top: 0px; width: 6px; }

.yui3-resize-handle-t { cursor: n-resize; top: 0px; }

.yui3-resize-handle-b { cursor: s-resize; bottom: 0px; }

.yui3-resize-handle-l { cursor: w-resize; left: 0px; }

.yui3-resize-handle-r { cursor: e-resize; right: 0px; }

.yui3-resize-handle-inner { position: absolute; zoom: 1; }

@media only screen and (min-device-width: 320px) and (max-device-width: 480px) {
  .yui3-resize-handle-inner::after { content: ""; width: 40px; height: 40px; position: absolute; }
  .yui3-resize-handle-inner-r, .yui3-resize-handle-inner-l, .yui3-resize-handle-inner-t, .yui3-resize-handle-inner-b, .yui3-resize-handle-inner-tr, .yui3-resize-handle-inner-br, .yui3-resize-handle-inner-tl, .yui3-resize-handle-inner-bl { overflow: visible !important; }
  .yui3-resize-handle-inner-r::after { top: -12px; right: 0px; }
  .yui3-resize-handle-inner-l::after { top: -12px; left: 0px; }
  .yui3-resize-handle-inner-t::after { top: 0px; left: -12px; }
  .yui3-resize-handle-inner-b::after { bottom: 0px; left: -12px; }
  .yui3-resize-handle-inner-tr::after { top: 0px; right: 0px; }
  .yui3-resize-handle-inner-br::after { bottom: 0px; right: 0px; }
  .yui3-resize-handle-inner-tl::after { top: 0px; left: 0px; }
  .yui3-resize-handle-inner-bl::after { bottom: 0px; left: 0px; }
}

@media only screen and (min-device-width: 768px) and (max-device-width: 1024px) {
  .yui3-resize-handle-inner::after { content: ""; width: 30px; height: 30px; position: absolute; }
  .yui3-resize-handle-inner-r, .yui3-resize-handle-inner-l, .yui3-resize-handle-inner-t, .yui3-resize-handle-inner-b, .yui3-resize-handle-inner-tr, .yui3-resize-handle-inner-br, .yui3-resize-handle-inner-tl, .yui3-resize-handle-inner-bl { overflow: visible !important; }
